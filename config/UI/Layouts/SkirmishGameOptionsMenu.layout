# Skirmish setup on the procedural UI system (docs/UI-DESIGN.md, mockup Skirmish.dc.html). Units: 1 = frame height / 1080.
# Frame: title top-left, players panel (left, 1104 wide), map and rules panels (right, 656 wide), Back and Start in the
# bottom bar. Panels are decorations drawn under the windows; every control keeps its name and callback.

# the root draws the blueprint frame (IMAGE MainMenuRuler), the dialog frame draws a border, its rule line and two unnamed
# grey boxes draw fills: none of them draw now. The two boxes are matched by their 800x600 rect, before SubParent moves.
hide SkirmishGameOptionsMenu.wnd:SkirmishGameOptionsMenuParent
hide at:58,387,291,499
hide at:300,387,746,499
window SkirmishGameOptionsMenu.wnd:SubParent left top 0 0 1920 1080
hide SkirmishGameOptionsMenu.wnd:SubParent
hide SkirmishGameOptionsMenu.wnd:Line
hide SkirmishGameOptionsMenu.wnd:ButtonResetFPS

# title
window SkirmishGameOptionsMenu.wnd:StaticTextTitle left top 64 40 560 48 title
ruler left top 64 94 560

# ---- players panel -------------------------------------------------------------------------------------------------
panel left top 64 124 1104 832
rule left top 84 182 1064
window SkirmishGameOptionsMenu.wnd:StaticTextPlayers left top 84 150 260 28 meta
window SkirmishGameOptionsMenu.wnd:StaticTextColor left top 360 150 64 28 meta
window SkirmishGameOptionsMenu.wnd:StaticTextFaction left top 440 150 400 28 meta
window SkirmishGameOptionsMenu.wnd:StaticTextTeam left top 1046 150 110 28 meta

# rows: pitch 48 from 200; controls 40 tall
